comment6.params=in
comment6.target=Nodo\ ripristinaAlbero(huffman_toolkit.InputTextFile)
comment6.text=public\ static\ Nodo\ ripristinaAlbero(InputTextFile\ in){\r\n\ \ \ \ \ \ \ \ char\ c\ \=\ in.readChar();\r\n\ \ \ \ \ \ \ \ if(c\ \=\=\ '@'){\r\n\ \ \ \ \ \ \ \ \ \ \ \ //Nodo\ Intermedio\r\n\ \ \ \ \ \ \ \ \ \ \ \ Nodo\ l\ \=\ ripristinaAlbero(in);\r\n\ \ \ \ \ \ \ \ \ \ \ \ Nodo\ r\ \=\ ripristinaAlbero(in);\r\n\ \ \ \ \ \ \ \ \ \ \ \ return\ new\ Nodo(l,\ r);\r\n\ \ \ \ \ \ \ \ }else{\r\n\ \ \ \ \ \ \ \ \ \ \ \ //Carattere\r\n\ \ \ \ \ \ \ \ \ \ \ \ if(c\ \=\=\ '\\\\'){\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ c\ \=\ in.readChar();\r\n\ \ \ \ \ \ \ \ \ \ \ \ }\r\n\ \ \ \ \ \ \ \ \ \ \ \ return\ new\ Nodo(c,\ 0);\r\n\ \ \ \ \ \ \ \ }\r\n}
